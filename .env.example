# Mac 서명·공증용 (이 파일을 복사해 .env 로 저장하세요)
# cp .env.example .env
# .env 는 git에 올라가지 않습니다.

APPLE_ID=your-apple-id@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XVWG95T72G

# 선택: 빌드 결과 폴더 (기본 ~/peekom-dist — Desktop/iCloud 밖 권장)
# PEEKOM_DIST_DIR=/Users/you/peekom-dist
# APPLE_TIMESTAMP_URL=http://timestamp.apple.com/ts01
